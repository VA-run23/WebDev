<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Whatsapp</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>
    <h3>All chats</h3>
    <form method="GET" action="chats/new">
        <button>New chat</button>
        <br>
    </form>
    <% for(let chat of chats){ %>
        <div class="chat">
            <p>from: <i>
                    <%= chat.from%>
                </i> </p>
            <div class="message">
                <p>
                    <%= chat.message%>
                </p>
                <form method="GET" action="/chats/<%= chat.id %>/edit">
                    <button>Edit</button>
                </form>
                <form method="POST" action="/chats/<%= chat.id %>?_method=DELETE">
                    <button>Delete</button>
                </form>
                <form method="GET" action="/chats/<%= chat.id %>">
                    <button>Show</button>
                </form>
            </div>
            <p>received by <i>
                    <%= chat.to %>
                </i></p>
            <hr>
            <p>
                <%=chat.created_at.toString().split(" ")[4]%></p>
        <p><i><%= chat.created_at.toString().split(" ").slice(0,4).join(" ") %></i></p>

        </div>
        <br><br>
    <%} %>
    
</body>
</html>