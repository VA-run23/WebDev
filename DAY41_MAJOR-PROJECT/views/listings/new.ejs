<% layout("/layouts/boilerplate.ejs") %>
  <div class="row">
    <div class="col-8 offset-2">
      <h2>Create a new listing</h2>
      <form method="POST" action="/listings" class="needs-validation" novalidate enctype="multipart/form-data">
        <div class="mb-3">
          <label for="title" class="form-label">Title</label>
          <input name="listing[title]" placeholder="Enter title" class="form-control" type="text" required />
          <div class="valid-feedback">
            Looks good!
          </div>
        </div>
        <div class="mb-3">
          <label for="description" class="form-label"> Description</label>
          <textarea name="listing[description]" placeholder="Enter Description" class="form-control"
            required></textarea>
        </div>
        <div class="mb-3">
          <label for="image" class="form-label"> Upload listing image</label>
          <input name="listing[image]" class="form-control" type="file" required/>
        </div>
        <div class="row">
          <div class="mb-3 col-md-4">
            <label for="price" class="form-label">Price</label>
            <input name="listing[price]" placeholder="Starts from 1200" class="form-control" type="number" required />
          </div>
          <div class="mb-3 col-md-8">
            <label for="country" class="form-label">Country</label>
            <input name="listing[country]" placeholder="Enter country" class="form-control" required />
            <div class="invalid-feedback">
              Please choose valid country.
            </div>
          </div>
        </div>
        <div class="mb-3">
          <label for="location" class="form-label">Location</label>
          <input for="location" name="listing[location]" placeholder="Enter location" class="form-control" type="text"
            required />
        </div>
        <button class="btn add-btn">Add</button>
      </form>
    </div>
  </div>
  <script src="../../public/js/script.js"></script>