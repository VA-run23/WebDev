<% layout("/layouts/boilerplate.ejs")%>
<!-- <%= success %>with regard to flash -->
    <!-- <h1>All listings</h1> -->
    <!--Action is where the form data is sent -->
    <!-- <form method="GET" action="/listings/new">// 
      <button> Creat New Listing</button>
    </form> -->
<style>
  #filters{
    display: flex;
    flex-wrap: wrap;
  }
  .filter{
    margin: 1rem 1rem 0  0;
    text-align: center;
    opacity: 0.7;
    align-items: center;
  }
  .filter p{
    font-size: 0.8rem;
  }

  #filters .filter i{
    font-size: 1.8rem;
  }
  .filter:hover{
    opacity:1;
    cursor: pointer;
  }
.tax-info{
  display: none;
}
.tax-toggle{
  border: 1px solid black;
  border-radius: .5rem;
  height:2.5rem;
  padding: 0.5rem;
  margin-left: 10rem;
  margin-top: 1rem;
  align-items: center;

}

</style>

<div id="filters">
  <div class="filter">
   <div><i class="fa-solid fa-fire"></i></div> 
   <p>Trending</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-bed"></i></div> 
    <p>Rooms</p>
   </div>
   <div class="filter">
    <div><i class="fa-solid fa-mountain-city"></i></div> 
    <p>Iconic Cities</p>
   </div>
   <div class="filter">
    <div><i class="fa-solid fa-mountain"></i></div> 
    <p>Mountains</p>
   </div>
   <div class="filter">
    <div><i class="fa-brands fa-fort-awesome"></i></div> 
    <p>Castel</p>
   </div>
   <div class="filter">
    <div><i class="fa-solid fa-person-swimming"></i></div> 
    <p>Amazing Pools</p>
   </div>
   <div class="filter">
    <div><i class="fa-solid fa-campground"></i></div> 
    <p>Camping</p>
   </div>
   <div class="filter">
    <div><i class="fa-regular fa-snowflake"></i></div> 
    <p>Arctic</p>
   </div>
   <div class="filter">
    <div><i class="fa-solid fa-cow"></i></div> 
    <p>Frams</p>
   </div>
   <div class="filter">
    <div><i class="fa-solid fa-igloo"></i></div> 
    <p>Domes</p>
   </div>
   <div class="filter">
    <div><i class="fa-solid fa-ship"></i></div> 
    <p>Boats</p>
   </div>
   <div class="tax-toggle">
    <div class="form-check-reverse form-switch">
      <input class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckDefault">
      <label class="form-check-label" for="flexSwitchCheckDefault">Display total after taxes</label>
    </div>
    
   </div>
</div>
    
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 ">
      <% for (let listing of allListings) { %>
        <a href="/listings/<%= listing._id %>" class="listing-link">
          <div class="card col">
            <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image" style="height: 20rem">
            <div class="card-img-overlay">Click for more details:&#41; </div>
            <div class="card-body">
              <h5 class="card-title"><%= listing.title %></h5>
              <p class="card-text">Price: ₹<%= listing.price ? listing.price.toLocaleString("en-IN") : 'N/A' %> per night 
              <i class="tax-info">+18% GST</i></p>
              <!-- <a href="#" class="btn btn-primary">Go somewhere</a> -->
            </div>
          </div>
        </a>
        <% } %>
    </div>


    <script>
      let taxSwitch=document.getElementById("flexSwitchCheckDefault");
     taxSwitch.addEventListener("click", ()=>{
      let taxInfo= document.getElementsByClassName("tax-info");
      for(info of taxInfo){
        if(info.style.display!= "inline"){
        info.style.display="inline"
        }else{
        info.style.display="none"
        }
      }
    });
    </script>